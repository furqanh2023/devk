# Copy to .env in the project root before production deployment.
# Firebase Web SDK config is already wired in src/firebase.js.
# Set this to the Firebase Authentication UID of the one designated administrator.
REACT_APP_ADMIN_UID=RB2xlRBlJEOwcBu1ENDJBNmYMMF3

# true = polished sample records for preview; false = no sample records in the UI.
# Use false before connecting real applicants or deploying publicly.
REACT_APP_DEMO_MODE=false
GENERATE_SOURCEMAP=false
